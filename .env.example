# ── Site ──────────────────────────────────────────────────────────────
# Public URL without trailing slash. On Vercel it falls back to the production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to "true" only when the shop really sells: lets search engines index it.
NEXT_PUBLIC_ALLOW_INDEXING=false
# Showcase mode (browse only, no orders, forms off). Default: on while STRIPE_SECRET_KEY is empty.
# SHOWCASE_MODE=true

# ── Admin (/admin, HTTP basic auth) ───────────────────────────────────
ADMIN_USER=
ADMIN_PASSWORD=

# ── Database (Neon Postgres; Vercel → Storage → Neon sets this) ──────
DATABASE_URL=

# ── Stripe (test keys until launch) ───────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# "true" once Stripe Tax is set up (registrations for BE/OSS) in the Stripe dashboard.
STRIPE_AUTOMATIC_TAX=false

# ── Email (Resend) ────────────────────────────────────────────────────
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Ajoin & Shine <hallo@example.be>"
EMAIL_FROM=
# Inbox for contact-form messages and withdrawal notices
CONTACT_TO_EMAIL=
# Shown on contact and legal pages
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Analytics (optional; loaded only after consent. Set one.) ─────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=
